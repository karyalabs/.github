#!/usr/bin/env bash
# Keeps a self-hosted macOS runner's disk from filling up. Installed as a
# LaunchAgent by ./install (every 6 hours and at login); safe to run by hand.
#
#   karya-runner-cleanup            clean
#   karya-runner-cleanup --dry-run  say what would go, delete nothing
#   karya-runner-cleanup --report   only show where the space is
#
# What it removes, in this order:
#   1. Always: runner logs older than 14 days, the old runner versions a
#      self-update leaves next to the current one, Homebrew's download cache,
#      Xcode DerivedData older than 14 days, simulators for runtimes that are
#      gone.
#   2. When no cargo or rustc is running: git dependency checkouts unused
#      for 30 days, pinned Rust toolchains that no runner checkout's
#      rust-toolchain.toml names any more, and, when free space is below
#      MIN_FREE_GB, the extracted crate sources (cargo unpacks them again).
#   3. When no job is running on any runner: target/ of checkouts no job has
#      used for STALE_DAYS, then, while free space is below MIN_FREE_GB, the
#      largest warm target/ first. A dropped target/ costs one cold build.
#
# Settings, from the environment or ~/.config/karya/runner-cleanup.env:
#   KARYA_CLEANUP_MIN_FREE_GB  free space to keep, default 100
#   KARYA_CLEANUP_STALE_DAYS   days before an unused target/ goes, default 7
#   KARYA_RUNNER_DIRS          runner folders, space separated; default every
#                              runner LaunchAgent's folder plus ~/actions-runner*
set -uo pipefail

config="$HOME/.config/karya/runner-cleanup.env"
# shellcheck disable=SC1090
[[ -f $config ]] && source "$config"

MIN_FREE_GB="${KARYA_CLEANUP_MIN_FREE_GB:-100}"
STALE_DAYS="${KARYA_CLEANUP_STALE_DAYS:-7}"
mode=clean
case "${1:-}" in
  --dry-run) mode=dry ;;
  --report) mode=report ;;
  "") ;;
  *) echo "usage: $0 [--dry-run|--report]" >&2; exit 2 ;;
esac

log() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"; }
free_gb() { df -Pk "$HOME" | awk 'NR == 2 { print int($4 / 1048576) }'; }
size_gb() { du -sk "$1" 2>/dev/null | awk '{ printf "%.1f", $1 / 1048576 }'; }

# Removes a path and says how big it was. Never follows a symlink.
remove() {
  local path="$1" why="$2"
  [[ -e $path || -L $path ]] || return 0
  log "$( [[ $mode == clean ]] && echo removing || echo 'would remove' ) $path ($(size_gb "$path") GB): $why"
  [[ $mode == clean ]] && rm -rf -- "$path"
  return 0
}

# A job runs in a Runner.Worker started from the runner's own bin folder.
job_running() {
  local runner
  for runner in $(runner_dirs); do
    pgrep -qf "$runner/bin[^/]*/Runner.Worker" && return 0
  done
  return 1
}
cargo_running() { pgrep -qx cargo || pgrep -qx rustc; }

runner_dirs() {
  {
    if [[ -n ${KARYA_RUNNER_DIRS:-} ]]; then
      printf '%s\n' $KARYA_RUNNER_DIRS
    else
      for plist in "$HOME"/Library/LaunchAgents/actions.runner.*.plist; do
        [[ -f $plist ]] && plutil -extract WorkingDirectory raw "$plist" 2>/dev/null
      done
      for dir in "$HOME"/actions-runner*; do [[ -d $dir ]] && echo "$dir"; done
    fi
  } | while read -r dir; do
    [[ -f $dir/.runner ]] && (cd "$dir" && pwd -P)
  done | sort -u
}

# Every cargo target/ under the runners' work folders, with the checkout's
# last use (actions/checkout fetches into it at the start of every job).
targets() {
  local runner tag target checkout used
  for runner in $(runner_dirs); do
    [[ -d $runner/_work ]] || continue
    find "$runner/_work" -maxdepth 5 -name CACHEDIR.TAG -path '*/target/CACHEDIR.TAG' 2>/dev/null |
      while read -r tag; do
        target="${tag%/CACHEDIR.TAG}"
        checkout="${target%/target}"
        used=0
        for marker in "$checkout/.git/FETCH_HEAD" "$checkout/.git/index" "$target"; do
          [[ -e $marker ]] && used=$(( $(stat -f %m "$marker") > used ? $(stat -f %m "$marker") : used ))
        done
        printf '%s %s %s\n' "$used" "$(du -sk "$target" 2>/dev/null | cut -f1)" "$target"
      done
  done
}

report() {
  log "free: $(free_gb) GB on $(df -P "$HOME" | awk 'NR == 2 { print $6 }'), keeping at least $MIN_FREE_GB GB"
  local runner
  for runner in $(runner_dirs); do
    log "runner $runner: $(size_gb "$runner") GB"
  done
  targets | sort -k2 -rn | while read -r used kb target; do
    log "  target $(awk -v kb="$kb" 'BEGIN { printf "%.1f", kb / 1048576 }') GB, last used $(date -r "$used" '+%Y-%m-%d'): $target"
  done
  local path
  for path in "$HOME/.cargo" "$HOME/.rustup" "$HOME/Library/Developer" \
    "$HOME/Library/Caches" "$HOME/Library/Containers/com.docker.docker"; do
    [[ -e $path ]] && log "$path: $(size_gb "$path") GB"
  done
  log "largest folders in $HOME:"
  du -xk -d 2 "$HOME" 2>/dev/null | sort -rn | sed -n '2,16p' |
    awk '{ size = $1; $1 = ""; printf "  %6.1f GB %s\n", size / 1048576, substr($0, 2) }'
  tmutil listlocalsnapshots / 2>/dev/null | grep -q . &&
    log "Time Machine keeps local snapshots; macOS frees them when it needs the space"
  return 0
}

if [[ $mode == report ]]; then
  report
  exit 0
fi

before="$(free_gb)"
log "start: $before GB free"

# 1. Always safe.
for runner in $(runner_dirs); do
  [[ -d $runner/_diag ]] &&
    find "$runner/_diag" -type f -mtime +14 -print0 2>/dev/null |
    while IFS= read -r -d '' file; do remove "$file" "runner log older than 14 days" >/dev/null; done
  for kind in bin externals; do
    current="$(readlink "$runner/$kind" 2>/dev/null || true)"
    [[ -n $current ]] || continue
    for old in "$runner/$kind".*; do
      [[ -d $old && $(basename "$old") != "$(basename "$current")" ]] &&
        remove "$old" "runner version replaced by a self-update"
    done
  done
done
if command -v brew >/dev/null; then
  if [[ $mode == clean ]]; then
    brew cleanup --prune=14 -s >/dev/null 2>&1 || log "brew cleanup failed"
  else
    remove "$(brew --cache 2>/dev/null)" "Homebrew download cache (brew cleanup)"
  fi
fi
if [[ -d $HOME/Library/Developer/Xcode/DerivedData ]]; then
  find "$HOME/Library/Developer/Xcode/DerivedData" -mindepth 1 -maxdepth 1 -mtime +14 -print0 |
    while IFS= read -r -d '' dir; do remove "$dir" "DerivedData older than 14 days"; done
fi
if [[ $mode == clean ]] && xcrun --find simctl >/dev/null 2>&1; then
  xcrun simctl delete unavailable >/dev/null 2>&1 || true
fi

# 2. Shared Rust caches, only while nothing builds.
if cargo_running; then
  log "cargo is running; leaving the Rust caches"
else
  # A build script that watches one of its own files reruns once when the
  # sources are unpacked again, so this waits until space is short.
  (( $(free_gb) < MIN_FREE_GB )) &&
    remove "$HOME/.cargo/registry/src" "extracted crate sources, unpacked again on demand"
  if [[ -d $HOME/.cargo/git/checkouts ]]; then
    find "$HOME/.cargo/git/checkouts" -mindepth 2 -maxdepth 2 -type d -mtime +30 -print0 |
      while IFS= read -r -d '' dir; do remove "$dir" "git dependency checkout unused for 30 days"; done
  fi
  if command -v rustup >/dev/null; then
    wanted="$(for runner in $(runner_dirs); do
        find "$runner/_work" -maxdepth 3 -name rust-toolchain.toml 2>/dev/null
      done | xargs -I{} sed -n 's/^[[:space:]]*channel[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' {} | sort -u)"
    default="$(rustup default 2>/dev/null | cut -d' ' -f1)"
    # Only pinned versions and dated nightlies go; stable, beta and nightly
    # are channels someone chose on purpose.
    rustup toolchain list 2>/dev/null | cut -d' ' -f1 | while read -r toolchain; do
      channel="${toolchain%-aarch64-apple-darwin}"
      channel="${channel%-x86_64-apple-darwin}"
      [[ $toolchain == "$default" ]] && continue
      [[ $channel =~ ^[0-9]+\.[0-9]+(\.[0-9]+)?$|^nightly-[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || continue
      grep -qxF "$channel" <<<"$wanted" && continue
      log "$( [[ $mode == clean ]] && echo removing || echo 'would remove' ) Rust $toolchain: no runner checkout uses it"
      [[ $mode == clean ]] && rustup toolchain uninstall "$toolchain" >/dev/null 2>&1
    done
  fi
fi

# 3. Build folders, only while no job runs.
if job_running; then
  log "a job is running; leaving every target/"
else
  now="$(date +%s)"
  list="$(targets)"
  while read -r used kb target; do
    [[ -n $target ]] || continue
    (( now - used > STALE_DAYS * 86400 )) &&
      remove "$target" "no job used this checkout for $STALE_DAYS days"
  done <<<"$list"
  # Largest first, until there is room again. A dry run frees nothing, so it
  # counts what it would have freed.
  freed=0
  while read -r used kb target; do
    [[ -n $target && -d $target ]] || continue
    (( $(free_gb) + freed / 1048576 >= MIN_FREE_GB )) && break
    remove "$target" "free space below $MIN_FREE_GB GB"
    [[ $mode == dry ]] && freed=$(( freed + kb ))
  done < <(sort -k2 -rn <<<"$list")
fi

after="$(free_gb)"
log "done: $after GB free ($(( after - before )) GB freed)"
if (( after < MIN_FREE_GB )) && [[ $mode == clean ]]; then
  log "still below $MIN_FREE_GB GB; run '$0 --report' to see what holds the space"
  osascript -e "display notification \"Only $after GB free. Run karya-runner-cleanup --report.\" with title \"Runner disk low\"" >/dev/null 2>&1 || true
fi
exit 0
